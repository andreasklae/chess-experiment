# Secrets
.env
*.env
!.env.example

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.venv/
**/venv/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Chess.com driver: temp profile dirs (we use tempfile.mkdtemp per game now,
# but the legacy persistent profile may still exist on developer machines).
backend/chesscom-profile/

# Maia weights — large binary artifacts, downloaded from
# https://github.com/CSSLab/maia-chess/releases/download/v1.0/maia-{elo}.pb.gz
backend/engines/maia/weights/*.pb.gz

# Stray screenshot dir created by the IDE when viewing .env attachments
backend/image/

# Game data — INTENTIONALLY NOT GITIGNORED
#
# `backend/games/` and `backend/batches/` are tracked. The CSVs (ranked.csv,
# experimental.csv), agent_elo.json, per-game JSON state, per-game agent
# reasoning traces, and batch state files are all part of the experiment's
# auditable record. Reverting a PR reverts its calibration rows too — this
# is by design. See:
#   knowledge-base/decisions/2026-05-24-ranked-vs-experimental.md

# Game-review engine output (derived analysis artifacts; regenerate with app.review)
backend/games/reviews/
